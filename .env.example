# Copy to .env when ready. Do not commit real secrets.

# Serving
MODEL_ID=/models/PLACEHOLDER_DO_NOT_RUN
SERVED_MODEL_NAME=btc-model
API_BASE=http://localhost:8000/v1
API_KEY=

# GPU/runtime
GPU_COUNT=all
TENSOR_PARALLEL_SIZE=1
GPU_MEMORY_UTILIZATION=0.90
MAX_MODEL_LEN=8192
DTYPE=auto

# Images
VLLM_IMAGE=vllm/vllm-openai:latest
BENCHMARK_IMAGE=llm-race-benchmark:local

# Monitoring
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
DCGM_EXPORTER_PORT=9400
