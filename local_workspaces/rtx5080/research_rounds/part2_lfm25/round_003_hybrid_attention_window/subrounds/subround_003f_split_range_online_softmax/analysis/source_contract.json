{
  "schema": "r003f.source_contract.v1",
  "image": "localhost/part2-lfm25-r002k:fused-bf16-greedy",
  "vllm_version": "0.22.1",
  "native_mm_prefix": {
    "mask": "(causal_and_window) or (query_in_range_and_key_in_range)",
    "persistent_prefix_for_later_queries": false,
    "causal_inside_prefix": false,
    "sliding_window_tile_pruning": false,
